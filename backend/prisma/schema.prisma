generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------
// โมเดล: Product (สินค้าในระบบ Market)
// ------------------------------------------
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  category    String   @default("ทั่วไป")
  stock       Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
